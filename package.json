{
  "name": "deepsea",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync && husky",
    "check:prompts": "node scripts/check-prompts.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check:e2e-policy": "node scripts/check-e2e-policy.mjs",
    "dev": "vite dev --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:update": "node scripts/run-e2e.mjs --update-snapshots",
    "verify": "npm run check && npm test && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "emulators": "firebase emulators:start --project demo-deepsea --only auth,firestore",
    "test:preview": "node scripts/run-e2e.mjs --live-preview",
    "format": "prettier --plugin prettier-plugin-svelte --write \"src/**/*.{svelte,ts}\" \"tests/unit/*.ts\" \"tests/e2e/*/*.spec.ts\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.61.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "22.20.2",
    "firebase-tools": "15.30.0",
    "husky": "9.1.7",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "firebase": "12.19.0"
  }
}
